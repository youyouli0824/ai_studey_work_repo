# ============================================================
#  企业人事制度知识库问答系统 — 环境变量模板
#  使用方式：复制本文件为 .env 并填写真实密钥（.env 已被 gitignore，不会提交）
#  注意：禁止把密钥硬编码进代码，统一在这里管理。
# ============================================================

# ---------- LLM 配置（DeepSeek 大模型生成回答） ----------
DEEPSEEK_API_KEY=sk-xxx          # DeepSeek API 密钥（必填，留空时生成模块会给出提示）
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1   # DeepSeek 兼容 OpenAI 的接口地址
DEEPSEEK_MODEL=deepseek-chat     # 对话模型名
DEEPSEEK_TEMPERATURE=0           # 温度：0 保证回答确定性，利于抑制幻觉

# ---------- Embedding 配置：本地 / 在线一键切换 ----------
# True = 使用本地 BGE 模型（离线可用，推荐）；False = 使用在线 Embedding API
USE_LOCAL_EMBED=True
# 本地 Embedding 模型路径（下载脚本会把模型放到这里，注意指向真实权重目录）
EMBED_MODEL_PATH=./models/BAAI/bge-large-zh-v1.5
EMBED_DEVICE=cpu                 # cpu / cuda，按机器资源选择
EMBED_DIM=1024                   # bge-large-zh-v1.5 向量维度为 1024

# 在线 Embedding API（OpenAI 兼容格式，USE_LOCAL_EMBED=False 时生效）
# 默认阿里云 dashscope 文本向量模型；若使用其他 OpenAI 兼容服务改 base/model 即可
EMBED_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBED_API_KEY=sk-xxx             # 在线 Embedding 密钥（可用 DASHSCOPE_API_KEY 代替）
EMBED_API_MODEL=text-embedding-v3

# ---------- Rerank 重排配置（Advanced-RAG，可选） ----------
# True = 开启 bge-reranker-base 重排，对 top-k 结果二次排序过滤；False = 关闭
USE_RERANK=True
# 重排模型路径：注意避开 HuggingFace 的 snapshots/master 软链陷阱，指向真实权重目录
RERANK_MODEL_PATH=./models/BAAI/bge-reranker-base
RERANK_DEVICE=cpu
RERANK_TOP_N=3                   # 重排后保留的片段数量

# ---------- RAG 业务参数（参数解耦：chunk_size / overlap / top_k 全部从这里读） ----------
CHUNK_SIZE=512                   # 滑动窗口切分：文本块大小（字符）
CHUNK_OVERLAP=50                 # 滑动窗口切分：相邻块重叠长度
SIM_TOP_K=6                      # 检索召回 top-K 候选片段数

# ---------- 数据与索引路径 ----------
DATA_DIR=./data                  # 制度文档存放目录（扫描其中全部 .docx）
VECTOR_DB_PATH=./vector_db       # Chroma 向量库持久化目录
CHROMA_COLLECTION=hr_policy_kb   # Chroma 集合名
