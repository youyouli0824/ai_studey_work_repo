# ============================================
# .env.example —— 环境变量模板
# 复制本文件为 .env 并填入真实密钥即可运行
# 注意：.env 含真实密钥，切勿提交到代码仓库
# ============================================

# ---- DeepSeek API 凭证（必填）----
API_KEY=your_deepseek_api_key_here
BASE_URL=https://api.deepseek.com/v1

# ---- 对话大模型（DeepSeek）----
LLM_MODEL=deepseek-v4-flash

# ---- 文本嵌入模型 ----
# local     : 本地 bge 中文嵌入模型（离线可用，无需额外密钥，推荐）
# dashscope : 阿里云 DashScope 嵌入（需额外配置 DASHSCOPE_API_KEY）
EMBED_PROVIDER=local
LOCAL_EMBED_MODEL=models/bge-small-zh-v1.5

# ---- 知识库来源（企业内部政策文档，多个用英文逗号分隔）----
# 本地文件路径 —— data/enterprise_policies.html（制造型企业制度汇编，内容最全）
# http(s)网页   —— 真实企业制度网页（WebBaseLoader 加载）
# 本地文件路径 —— data/enterprise_policies.html（制造型企业制度汇编，内容最全）
# http(s)网页   —— 真实企业制度网页（WebBaseLoader 加载，如夏津燃气员工手册）
#                还可追加：http://www.yinan.gov.cn/info/2957/115607.htm（考勤/请假/加班细则）
KNOWLEDGE_URLS=data/enterprise_policies.html,http://www.xiajin.gov.cn/n31121413/n44484126/n44486980/n75335382/n75336004/n75336529/c75760423/content.html
# 网页正文容器 class（多个候选用 | 分隔，程序自动为每个网页选用提取内容最多的那个；
# 用于过滤导航/广告等无关标签，只提取正文；留空则提取整页）
CONTENT_SELECTOR=article-content|p-2 text-justify

# ---- FAISS 向量库目录 ----
FAISS_DIR=faiss_store

# ---- RAG 检索返回的相关文档条数 ----
RETRIEVER_K=3

# ---- 可选：DashScope 嵌入凭证（EMBED_PROVIDER=dashscope 时使用）----
# DASHSCOPE_API_KEY=your_dashscope_key_here
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# EMBED_MODEL=text-embedding-v4
